# ===========================================
# SHORTLY LOCAL ENVIRONMENT (docker compose)
# ===========================================
# Copy this file to .env and fill in real values. .env is git-ignored.
# Variable names are the ones docker-compose.yml reads; they map to the application's configuration keys.

# PostgreSQL password (used by both the database container and the API connection string)
DB_PASSWORD=[ur-db-password]

# JWT signing (maps to Jwt:Key / Jwt:Issuer / Jwt:Audience). The key must be at least 32 characters.
JWT__KEY=[YourVeryStrongJWTKey-at-least-32-characters]
JWT__ISSUER=shortly-dev
JWT__AUDIENCE=shortly-dev-clients

# Google sign-in (maps to Authentication:Google:*). Optional for local development.
GOOGLE_CLIENT_ID=[google-client-id]
GOOGLE_CLIENT_SECRET=[google-client-secret]

# SMTP (maps to EmailSettings:Smtp:Username / Password). Optional for local development.
EMAIL_USERNAME=[ur-smtp-email]
EMAIL_PASSWORD=[ur-smtp-password]

# Optional: host port for the API (default 5001)
# API_PORT=5001
